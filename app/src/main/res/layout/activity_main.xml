<?xml version="1.0" encoding="utf-8"?>
<!-- Place title, page tabs (Now / Hourly / 7 days), the page, soft keys. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="28dp"
        android:background="@color/strip_bg"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp"
        android:singleLine="true"
        android:textColor="@color/text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/tabs"
        android:layout_width="match_parent"
        android:layout_height="22dp"
        android:orientation="horizontal">

        <TextView style="@style/Tab" android:id="@+id/tab_now" android:text="Now" />
        <TextView style="@style/Tab" android:id="@+id/tab_hours" android:text="Hourly" />
        <TextView style="@style/Tab" android:id="@+id/tab_days" android:text="7 days" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Now page -->
        <LinearLayout
            android:id="@+id/now"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="8dp"
            android:paddingTop="4dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/symbol"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:textSize="34sp" />

                <TextView
                    android:id="@+id/temp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:textColor="@color/text"
                    android:textSize="50sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/condition"
                style="@style/NowLine"
                android:textColor="@color/text"
                android:textSize="18sp" />

            <TextView android:id="@+id/line1" style="@style/NowLine" />
            <TextView android:id="@+id/line2" style="@style/NowLine" />
            <TextView android:id="@+id/line3" style="@style/NowLine" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/status"
                style="@style/NowLine"
                android:paddingBottom="2dp"
                android:textSize="12sp" />
        </LinearLayout>

        <dev.mike.fieroweather.ui.ListScreen
            android:id="@+id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <include layout="@layout/soft_keys" />
</LinearLayout>
